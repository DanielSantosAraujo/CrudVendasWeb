@model VendasWebMvc.Models.ViewModels.VendedorFormViewModel

@{
    ViewData["Title"] = "Criar";
}

<h2>@ViewData["Title"]</h2>

<h4>Vendedor</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Vendedor.Nome" class="form-label"></label>
                <input asp-for="Vendedor.Nome" class="form-control" />
                <span asp-validation-for="Vendedor.Nome" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Vendedor.Email" class="form-label"></label>
                <input asp-for="Vendedor.Email" class="form-control" />
                <span asp-validation-for="Vendedor.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Vendedor.DataNascimento" class="form-label"></label>
                <input asp-for="Vendedor.DataNascimento" class="form-control" />
                <span asp-validation-for="Vendedor.DataNascimento" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Vendedor.Salario" class="form-label"></label>
                <input asp-for="Vendedor.Salario" class="form-control" />
                <span asp-validation-for="Vendedor.Salario" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Vendedor.DepartamentoId" class="form-label"></label>
                <select asp-for="Vendedor.DepartamentoId" asp-items="@(new SelectList(Model.Departamentos, "Id", "Nome"))" class="form-select"></select>
                <span asp-validation-for="Vendedor.DepartamentoId" class="text-danger"></span>
            </div>


            <div class="mb-3">
                <input type="submit" value="Create" class="btn btn-secondary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}